<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Configure iisnode to run app.js -->
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Rewrite all URLs (except actual files on disk) to app.js for Hono routing -->
        <rule name="DynamicContent">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Prevent IIS from replacing Node.js error responses (like 500 JSON errors) with default HTML pages -->
    <httpErrors existingResponse="PassThrough" />
    <iisnode watchedFiles="web.config;*.js;*.cjs;dist\boot.cjs" />
  </system.webServer>
</configuration>
